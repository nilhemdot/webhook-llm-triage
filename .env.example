# Copy to .env and fill in. Never commit .env.

# Shared value Zapier sends in the X-Webhook-Secret header. Required: every /intake call is refused while empty.
WEBHOOK_SECRET=

# Leave commented out locally so the SDK uses your `ant auth login` sign-in (an empty value would override it).
# Set it on the host only, from a Console workspace with a spend limit.
# ANTHROPIC_API_KEY=

ANTHROPIC_MODEL=claude-sonnet-5-5

# Where SQLite and dead letters live (/var/data on Render).
DATA_DIR=./data

# Daily cap on LLM-calling intake events (UTC day).
MAX_EVENTS_PER_DAY=200
